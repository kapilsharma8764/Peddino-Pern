# Copy this file to .env (git-ignored) and fill in the values you have.
# The server loads this file itself on startup — no extra setup needed.

# "Sign in with Google". Must be the same client id as the client's
# VITE_GOOGLE_CLIENT_ID — one Google app, used by both sides. Leave unset to
# turn the feature off; the route then replies 503 instead of failing oddly.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Local PostgreSQL (see README-RUN.md section 0):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/sitebuilder

# See README-RUN.md for the rest (SITEBUILDER_SECRET, DATABASE_URL,
# SITEBUILDER_OWNER_EMAIL / SITEBUILDER_OWNER_PASSWORD).

# ── Production (Render / Railway / Fly) ─────────────────────────────────────
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?sslmode=require
# SITEBUILDER_SECRET=a-long-random-string
# SITEBUILDER_CORS_ORIGIN=https://your-app.vercel.app
# SITEBUILDER_OWNER_EMAIL=you@example.com
# SITEBUILDER_OWNER_PASSWORD=choose-a-strong-one

# ── AI (optional) ───────────────────────────────────────────────────────────
# One free key from https://aistudio.google.com/apikey turns AI on for everyone
# who signs in, so nobody has to paste a key into their browser. Unset, the
# builder works as before and asks for a personal key in Settings.
# GEMINI_API_KEY=your-key

# Password reset email (Resend, with a verified sender domain):
# RESEND_API_KEY=your-resend-key
# SITEBUILDER_MAIL_FROM=Peddino <support@your-domain.com>

# Copy this file to .env.local (git-ignored) and fill in the values you have.

# Where the API runs. Only needed if it is not http://localhost:8001.
# VITE_API_URL=http://localhost:8001

# "Sign in with Google" on the sign-in page. Leave unset to hide that button —
# the rest of sign-in/sign-up works the same without it. Get this from
# https://console.cloud.google.com/apis/credentials (see README-RUN.md).
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Vercel: set this in Project → Settings → Environment Variables. It must be the
# API's https:// address; the build fails without it.
# VITE_API_URL=https://your-api.onrender.com

# Try the live setup locally: forward /original-templates and /templates/<folder>
# to the API (which serves them from MongoDB) instead of reading client/public.
# SITEBUILDER_TEMPLATE_PROXY=http://localhost:8001
